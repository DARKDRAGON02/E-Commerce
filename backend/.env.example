# Copy to backend/.env and fill in.

# MongoDB connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Express port (defaults to 5000 when unset)
PORT=5000

# Allowed CORS origin. If this is unset the server falls back to reflecting any
# origin while sending credentials - set it explicitly in production.
REACT_SERVER=http://localhost:5173

# Firebase Admin credentials are NOT environment variables.
# Download a service-account key from the Firebase console and save it as
# backend/serviceAccountKey.json (already gitignored).
